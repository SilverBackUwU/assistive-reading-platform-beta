APP_NAME=Sarvagya
APP_VERSION=0.2.0
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs
MAX_UPLOAD_SIZE_MB=20

SARVAM_API_KEY=your_sarvam_key_here
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_TIMEOUT_SECONDS=60
SARVAM_VISION_ENDPOINT=/vision/ocr
SARVAM_TRANSLATE_ENDPOINT=/translate
SARVAM_TTS_ENDPOINT=/text-to-speech
SARVAM_VISION_MODEL=sarvam-vision
SARVAM_TRANSLATE_MODEL=sarvam-translate
SARVAM_TTS_MODEL=bulbul
SARVAM_TTS_VOICE=meera
SARVAM_SOURCE_LANGUAGE=sa-IN
SARVAM_TARGET_LANGUAGE=en-IN

LIBLOUIS_TABLE=en-us-g2.ctb
BRF_LINE_WIDTH=32
BRF_PAGE_HEIGHT=25

DATABASE_URL=
